<mujoco model="fruitpick">
    <compiler angle="radian"/>

    <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" impratio="10">
        <flag contact="enable" energy="enable" gravity="enable"/>
    </option>

    <visual>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <mesh name="table" file="../objects/table/table.STL" scale="1.0 1.0 0.77"/>

        <texture type="skybox" builtin="gradient" rgb1="0.68 0.68 0.68" rgb2="0.3 0.3 0.3" width="512" height="3072"/>
        <texture name="groundplane" type="2d" builtin="checker" mark="edge" rgb1="0.68 0.68 0.68" rgb2="0.8 0.8 0.8"
                 markrgb="0.68 0.68 0.68" width="300" height="300"/>
        <material name="groundplane" reflectance="0.2" shininess="0.0" specular="0.5" texrepeat="5 5"
                  texture="groundplane" texuniform="true"/>

        <!-- 苹果树资源 -->
        <mesh name="appletree_mesh" file="../objects/appletree/appletree.obj" scale="2.1 2.1 2.1"/>
        <texture name="tree_texture" type="2d" file="../objects/appletree/texture14.png"/>
        <material name="tree_material" texture="tree_texture" texrepeat="1 1" texuniform="true" rgba="1 1 1 1"/>
        
        <!-- 苹果的纹理、材质和网格 -->
        <texture name="tex_apple" type="2d" file="../objects/fruits/apple/apple.png"/>
        <material name="mat_apple" reflectance="0.7" texrepeat="15 15" texture="tex_apple" texuniform="true"/>
        <mesh name="mesh_apple_visual" file="../objects/fruits/apple/apple.stl" scale="1.2 1.2 1.2"/>
    </asset>

    <worldbody>
        <!-- Floor -->
        <geom condim="3" material="groundplane" name="floor" pos="0 0 0" size="3 3 .125" type="plane"/>
        <light diffuse=".8 .8 .8" dir="0 -0.15 -1" directional="false" pos="1 1 8.0" specular="0.3 0.3 0.3"
               castshadow="false"/>
        <light diffuse=".8 .8 .8" dir="0 -0.15 -1" directional="false" pos="-3. -3 8.0" specular="0.3 0.3 0.3"
               castshadow="false"/>
        
        <!-- 苹果树 -->
        <body name="apple_tree" pos="0.8 0.6 0.8" euler="1.570796 0 0">
            <geom name="tree_visual" type="mesh" mesh="appletree_mesh" material="tree_material" contype="0" conaffinity="0"/>
        </body>
        
        <!-- 果柄连接点（固定在树上的锚点） -->
        <body name="stem_anchor" pos="0.65 0.15 0.85">
            <!-- 果柄（极小的圆柱体，仅作视觉参考） -->
            <geom name="stem_visual" type="cylinder" size="0.001 0.002" rgba="0.4 0.3 0.1 0" 
                  contype="0" conaffinity="0"/>
            <!-- 果柄连接点（苹果将通过约束连接到此点） -->
            <site name="stem_attach" pos="0 0 -0.005" size="0.003" rgba="0 0.5 0 0" type="sphere"/>
        </body>
        
        <!-- 苹果物体（自由物体，通过 connect 约束连接到果柄） -->
        <body name="apple_body" pos="0.65 0.15 0.8">
            <!-- 自由关节：使苹果可以自由移动（剪断后掉落） -->
            <freejoint name="apple_free"/>
            <inertial mass="0.15" pos="0 0 0" diaginertia="0.0001 0.0001 0.0001"/>
            
            <!-- 视觉几何体：使用带纹理的网格，不参与碰撞 -->
            <geom name="apple_visual" type="mesh" mesh="mesh_apple_visual" material="mat_apple" contype="0" conaffinity="0"/>
            <!-- 碰撞几何体：用一个简单的球体近似代替，参与物理碰撞 -->
            <geom name="apple_collision" type="sphere" size="0.04" pos="0 0 0" density="1000" rgba="0 0 0 0"/>
            <!-- 苹果中心位置 -->
            <site name="fruit_site" pos="0 0 0" size="0.005" rgba="0 1 0 0" type="sphere"/>
            <!-- 抓取目标位置（苹果上方 0.05m，连接点） -->
            <site name="pick_site" pos="0 0 0.05" size="0.002" rgba="1 0 0 0" type="sphere"/>
            <!-- 苹果顶部连接点（与果柄 connect 约束配对） -->
            <site name="apple_attach" pos="0 0 0.05" size="0.002" rgba="0 0 1 0" type="sphere"/>
        </body>
        
        <!-- 主相机视角 -->
        <camera mode="fixed" name="front_view_cam" pos="1.8 0 1.3" quat="0.62 0.35 0.35 0.62"/>

        <body name="table" pos="0.3 0.6 0.0" euler="0 0 1.57">
            <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.68 0.68 0.68 1" mesh="table"
                  friction="0.95 0.9 0.9"/>
            <geom type="mesh" conaffinity="1" condim="3" contype="0" group="4" rgba="0.68 0.68 0.68 1" mesh="table"
                  friction="0.95 0.9 0.9"/>
        </body>

    </worldbody>
    
    <!-- 等式约束：将苹果连接到果柄（可通过代码禁用以实现剪断效果） -->
    <equality>
        <!-- 
            connect 约束：将 apple_body 的 apple_attach 点连接到 stem_anchor 的 stem_attach 点
            anchor: 相对于 body1 (apple_body) 的连接点位置
            当 eq_active[id] = 0 时，约束被禁用，苹果会掉落
        -->
        <connect name="apple_stem_connect" body1="apple_body" body2="stem_anchor" 
                 anchor="0 0 0.05" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </equality>
</mujoco>
