<mujoco model="umi_scissors_attached">
    <compiler angle="radian"/>
    
    <asset>
        <mesh name="umi_scissors_mesh" file="meshes/UMI-scissors.STL" scale="0.0008 0.0008 0.0008"/>
    </asset>
    
    <default>
        <geom friction="1 0.005 0.0001" condim="3" contype="1" conaffinity="1"/>
    </default>
    
    <worldbody>
        <!-- 夹爪整体 -->
        <!-- pos 调整为让夹爪底座与机械臂末端对齐 -->
        <!-- 绕 X 轴顺时针旋转 90 度 (-1.57 弧度) -->
        <body name="umi_scissors_base" pos="-0.042 -0.055 0.22" euler="0 1.57 0">
            <inertial mass="0.2" pos="0 0 0.05" diaginertia="0.001 0.001 0.001"/>
            
            <geom name="scissors_visual" type="mesh" mesh="umi_scissors_mesh" rgba="0.6 0.6 0.6 1" 
                  contype="0" conaffinity="0" group="1"/>
            
            <!-- 碰撞几何体：用简单形状近似剪刀外形 -->
            <geom name="scissors_col_1" type="box" size="0.053 0.028 0.03" pos="0.171 0.058 0.045" 
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_2" type="box" size="0.049 0.022 0.022" pos="0.169 0.11 0.045" 
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_3" type="capsule" size="0.018" fromto="0.2 0.03 0.045 0.14 0.03 0.045" 
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_4" type="capsule" size="0.014" fromto="0.12 0.058 0.045 0.03 0.058 0.045" 
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_5" type="box" size="0.008 0.003 0.01" pos="0.0205 0.058 0.064" euler="0 0.524 0"
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_6" type="box" size="0.008 0.003 0.01" pos="0.0205 0.058 0.026" euler="0 -0.524 0"
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_7" type="box" size="0.012 0.02 0.03" pos="0.122 0.17 0.029" euler="0 0 0.31"
                  rgba="1 0 0 0" group="0"/>
            <geom name="scissors_col_8" type="box" size="0.005 0.007 0.035" pos="0.137 0.13 0.045" 
                  rgba="1 0 0 0" group="0"/>
            

            <!-- 末端执行器标记点 (IK求解目标) -->
            <!-- 调整位置以匹配新的模型长度 -->
            <site name="pinch" pos="0 0 0.15" size="0.005" rgba="1 0 0 0" type="sphere"/>

            <!-- 作用点 (Action Point) - 位置待定用红色小球渲染 -->
            <site name="action_point" pos="0.005 0.055 0.045" size="0.001" rgba="1 0 0 0" type="sphere"/>
            
            <!-- 腕部相机 (参考 robotiq_realsense 的 wrist_cam) -->
            <camera name="wrist_cam" pos="0.12 0.15 0.045" quat="0.701 -0.092 0.701 0.092" fovy="60"/>
        </body>
    </worldbody>
    
    <!-- 移除 actuation, contact, equality -->
</mujoco>
