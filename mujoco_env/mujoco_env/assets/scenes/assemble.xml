<mujoco model="empty_floor">
    <compiler angle="radian"/>

    <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" impratio="10">
        <flag contact="enable" energy="enable" gravity="enable"/>
    </option>

    <visual>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <!--  <default>-->
    <!--    <geom solref="0.01 1" solimp=".95 .99 .0001" condim="1"/>-->
    <!--  </default>-->

    <asset>
        <mesh name="table" file="../objects/table/table.STL" scale="1.0 1.0 0.77"/>
        <mesh name="pedestal" file="../objects/pedestal/pedestal.STL"/>

        <texture type="skybox" builtin="gradient" rgb1="0.68 0.68 0.68" rgb2="0.3 0.3 0.3" width="512" height="3072"/>
        <texture name="groundplane" type="2d" builtin="checker" mark="edge" rgb1="0.68 0.68 0.68" rgb2="0.8 0.8 0.8"
                 markrgb="0.68 0.68 0.68" width="300" height="300"/>
        <material name="groundplane" reflectance="0.2" shininess="0.0" specular="0.5" texrepeat="5 5"
                  texture="groundplane" texuniform="true"/>

        <texture name="wood" type="2d" file="../textures/wood.png"/>
        <material name="wood" texture="wood" texrepeat="1 1" texuniform="true" rgba="0.68 0.68 0.68 1"/>
    </asset>

    <worldbody>
        <!-- Floor -->
        <geom condim="3" material="groundplane" name="floor" pos="0 0 0" size="3 3 .125" type="plane"/>
        <light diffuse=".8 .8 .8" dir="0 -.15 -1" directional="false" pos="1 1 8.0" specular="0.3 0.3 0.3"
               castshadow="false"/>
        <light diffuse=".8 .8 .8" dir="0 -.15 -1" directional="false" pos="-3. -3. 8.0" specular="0.3 0.3 0.3"
               castshadow="false"/>
        <!-- front view -->
        <camera mode="fixed" name="frontview" pos="1.6 0 1.45" quat="0.56 0.43 0.43 0.56"/>
        <!-- bird view -->
        <camera mode="fixed" name="birdview" pos="-0.2 0 3.0" quat="0.7071 0 0 0.7071"/>
        <!-- agent view -->
        <camera mode="fixed" name="agentview" pos="0.5 0 1.35" quat="0.653 0.271 0.271 0.653"/>
        <!-- side view -->
        <camera mode="fixed" name="sideview" pos="-0.05651774593317116 1.2761224129427358 1.4879572214102434"
                quat="0.009905065491771751 0.006877963156909582 0.5912228352893879 0.806418094001364"/>

        <body name="table" pos="0.3 0.6 0.0" euler="0 0 1.57">
            <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.68 0.68 0.68 1" mesh="table"
                  friction="0.95 0.9 0.9"/>
            <geom type="mesh" conaffinity="1" condim="3" contype="0" group="4" rgba="0.68 0.68 0.68 1" mesh="table"
                  friction="0.95 0.9 0.9"/>
        </body>
        <body name="pedestal" pos="0 0 0.092">
            <inertial diaginertia="6.0869 5.81635 4.20915" mass="60.864" pos="0 0 0"
                      quat="0.659267 -0.259505 -0.260945 0.655692"/>
            <geom conaffinity="0" contype="0" group="1" mesh="pedestal" type="mesh" name="pedestal_vis" rgba="1 1 1 1"/>
        </body>
    </worldbody>
</mujoco>
